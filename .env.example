# Supabase-Projekt (Dashboard → Project Settings → API)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Nur serverseitig: Secret Key für tägliche Jobs und den Versand. Nie im Client verwenden.
NUXT_SUPABASE_SECRET_KEY=

# Schützt /api/cron/daily. Auf Vercel denselben Wert zusätzlich als CRON_SECRET anlegen,
# damit Vercel ihn beim täglichen Aufruf als Bearer-Token mitsendet.
NUXT_CRON_SECRET=

# Basis-URL für Links in E-Mails und Push (lokal leer lassen)
NUXT_PUBLIC_SITE_URL=

# E-Mail-Benachrichtigungen über SMTP (Strato: smtp.strato.de, Port 465)
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
# Absender, z. B. "Auswärtsfahrt <login@deine-subdomain.de>" (muss zum SMTP-Konto passen)
NUXT_SMTP_FROM=

# Web-Push: Schlüsselpaar erzeugen mit `pnpm exec web-push generate-vapid-keys`
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=
# Kontakt für Push-Dienste, z. B. mailto:login@deine-subdomain.de
NUXT_VAPID_SUBJECT=
